    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'sent', channel: 'sms_fallback', event_id: $('Verify Stripe Signature').item.json.event_id } }}",
        "options": { "responseCode": 200 }
      },
      "id": "respond-sms-ok",
      "name": "Respond 200 (SMS Sent)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [2440, 420]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO failed_jobs (workflow_name, item_key, payload, error_message, error_node, retry_count) VALUES ('stripe-whatsapp', ?, ?, ?, ?, 0)",
        "options": {
          "queryReplacement": "={{ $('Verify Stripe Signature').item.json.event_id }}, {{ JSON.stringify({ event_type: $('Verify Stripe Signature').item.json.event_type, session_id: $('Verify Stripe Signature').item.json.event.data.object.id }).slice(0, 10000) }}, {{ ($json.error && $json.error.message) || $json.message || 'both channels failed' }}, {{ $json.error && $json.error.node && $json.error.node.name || 'twilio-sms' }}"
        }
      },
      "id": "mysql-failed-jobs",
      "name": "MySQL: Record failed_jobs",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [2240, 620],
      "credentials": {
        "mySql": {
          "id": "REPLACE_WITH_MYSQL_CRED_ID",
          "name": "MySQL (orders DB)"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'queued_for_retry', event_id: $('Verify Stripe Signature').item.json.event_id } }}",
        "options": { "responseCode": 200 }
      },
      "id": "respond-failed-queued",
      "name": "Respond 200 (Queued)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [2440, 620]
    },
    {
      "parameters": {},
