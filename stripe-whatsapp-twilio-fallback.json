        "options": {
          "queryReplacement": "={{ $json.workflow.name }}, {{ $json.execution.id }}, {{ JSON.stringify($json).slice(0, 10000) }}, {{ $json.execution.error.message }}, {{ $json.execution.lastNodeExecuted }}"
        }
      },
      "id": "mysql-error-trigger-log",
