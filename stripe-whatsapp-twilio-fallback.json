{
  "name": "Stripe → WhatsApp → Twilio fallback (idempotent)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "stripe-webhook",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true,
          "allowedOrigins": "*"
        }
      },
      "id": "webhook-stripe",
      "name": "Webhook (Stripe)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 400],
      "webhookId": "stripe-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Verify Stripe signature — HMAC-SHA256 over `timestamp.rawBody`\n// See https://stripe.com/docs/webhooks/signatures\nconst crypto = require('crypto');\n\nconst secret = $env.STRIPE_WEBHOOK_SECRET;\nif (!secret) throw new Error('Missing STRIPE_WEBHOOK_SECRET env var');\n\nconst item = $input.item;\nconst sigHeader = item.json.headers['stripe-signature'];\nif (!sigHeader) {\n  return { json: { valid: false, reason: 'missing_signature' } };\n}\n\n// Raw body arrives as binary when Webhook `rawBody` option is on\nlet rawBody;\nif (item.binary && item.binary.data) {\n  rawBody = Buffer.from(item.binary.data.data, 'base64').toString('utf8');\n} else {\n  rawBody = JSON.stringify(item.json.body);\n}\n\n// Parse Stripe signature header: t=...,v1=...\nconst parts = Object.fromEntries(\n  sigHeader.split(',').map(p => {\n    const [k, v] = p.split('=');\n    return [k, v];\n  })\n);\nconst timestamp = parts.t;\nconst v1 = parts.v1;\nif (!timestamp || !v1) {\n  return { json: { valid: false, reason: 'malformed_signature' } };\n}\n\n// Reject replays older than 5 minutes\nconst ageSec = Math.floor(Date.now() / 1000) - Number(timestamp);\nif (ageSec > 300) {\n  return { json: { valid: false, reason: 'stale_timestamp', age: ageSec } };\n}\n\nconst signedPayload = `${timestamp}.${rawBody}`;\nconst expected = crypto.createHmac('sha256', secret).update(signedPayload).digest('hex');\n\n// Constant-time compare\nconst a = Buffer.from(expected, 'hex');\nconst b = Buffer.from(v1, 'hex');\nconst valid = a.length === b.length && crypto.timingSafeEqual(a, b);\n\nlet event = {};\ntry { event = JSON.parse(rawBody); } catch (_) {}\n\nreturn {\n  json: {\n    valid,\n    event,\n    event_id: event.id ?? null,\n    event_type: event.type ?? null,\n    payload_hash: crypto.createHash('sha256').update(rawBody).digest('hex')\n  }\n};"
      },
      "id": "verify-signature",
      "name": "Verify Stripe Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-signature-valid",
      "name": "IF: Signature Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [640, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { error: 'invalid_signature', reason: $json.reason } }}",
        "options": { "responseCode": 400 }
      },
      "id": "respond-400",
      "name": "Respond 400 (Bad Signature)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [840, 600]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT item_key FROM processed_items WHERE item_key = ? AND workflow_name = 'stripe-whatsapp' LIMIT 1",
        "options": {
          "queryReplacement": "={{ $json.event_id }}"
        }
      },
      "id": "mysql-check-processed",
      "name": "MySQL: Already Processed?",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [840, 300],
      "credentials": {
        "mySql": {
          "id": "REPLACE_WITH_MYSQL_CRED_ID",
          "name": "MySQL (orders DB)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $items().length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-already-processed",
      "name": "IF: Already Processed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1040, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'duplicate', event_id: $('Verify Stripe Signature').item.json.event_id } }}",
        "options": { "responseCode": 200 }
      },
      "id": "respond-duplicate",
      "name": "Respond 200 (Duplicate)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [1240, 180]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $('Verify Stripe Signature').item.json.event_type }}",
              "rightValue": "checkout.session.completed",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-event-type",
      "name": "IF: checkout.session.completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1240, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'ignored', event_type: $('Verify Stripe Signature').item.json.event_type } }}",
        "options": { "responseCode": 200 }
      },
      "id": "respond-ignored",
      "name": "Respond 200 (Ignored Event)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [1440, 560]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT order_id, customer_name, phone_e164, locale FROM orders WHERE stripe_customer_id = ? OR stripe_session_id = ? ORDER BY created_at DESC LIMIT 1",
        "options": {
          "queryReplacement": "={{ $('Verify Stripe Signature').item.json.event.data.object.customer }}, {{ $('Verify Stripe Signature').item.json.event.data.object.id }}"
        }
      },
      "id": "mysql-lookup-customer",
      "name": "MySQL: Lookup Customer",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [1440, 300],
      "credentials": {
        "mySql": {
          "id": "REPLACE_WITH_MYSQL_CRED_ID",
          "name": "MySQL (orders DB)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $env.META_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.phone_e164 }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"order_confirmation\",\n    \"language\": { \"code\": \"{{ $json.locale || 'en_US' }}\" },\n    \"components\": [\n      {\n        \"type\": \"body\",\n        \"parameters\": [\n          { \"type\": \"text\", \"text\": \"{{ $json.customer_name }}\" },\n          { \"type\": \"text\", \"text\": \"{{ $json.order_id }}\" }\n        ]\n      }\n    ]\n  }\n}",
        "options": {
          "timeout": 10000,
          "response": { "response": { "neverError": true, "fullResponse": true } }
        }
      },
      "id": "http-whatsapp",
      "name": "Meta Cloud API: Send WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1640, 300],
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_META_CRED_ID",
          "name": "Meta Cloud API (Bearer)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": { "type": "number", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-whatsapp-success",
      "name": "IF: WhatsApp Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1840, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO processed_items (item_key, workflow_name, status, payload_hash) VALUES (?, 'stripe-whatsapp', 'success', ?) ON DUPLICATE KEY UPDATE status=VALUES(status), processed_at=CURRENT_TIMESTAMP",
        "options": {
          "queryReplacement": "={{ $('Verify Stripe Signature').item.json.event_id }}, {{ $('Verify Stripe Signature').item.json.payload_hash }}"
        }
      },
      "id": "mysql-record-whatsapp-success",
      "name": "MySQL: Record Success (WA)",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [2040, 180],
      "credentials": {
        "mySql": {
          "id": "REPLACE_WITH_MYSQL_CRED_ID",
          "name": "MySQL (orders DB)"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'sent', channel: 'whatsapp', event_id: $('Verify Stripe Signature').item.json.event_id } }}",
        "options": { "responseCode": 200 }
      },
      "id": "respond-wa-ok",
      "name": "Respond 200 (WA Sent)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [2240, 180]
    },
    {
      "parameters": {
