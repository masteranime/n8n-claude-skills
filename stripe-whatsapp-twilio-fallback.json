        "operation": "send",
        "from": "={{ $env.TWILIO_FROM_NUMBER }}",
        "to": "={{ $('MySQL: Lookup Customer').item.json.phone_e164 }}",
        "message": "=Order {{ $('MySQL: Lookup Customer').item.json.order_id }} confirmed. Thank you, {{ $('MySQL: Lookup Customer').item.json.customer_name }}."
      },
      "id": "twilio-sms",
      "name": "Twilio: Send SMS Fallback",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [2040, 420],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput",
      "credentials": {
        "twilioApi": {
          "id": "REPLACE_WITH_TWILIO_CRED_ID",
          "name": "Twilio"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO processed_items (item_key, workflow_name, status, payload_hash) VALUES (?, 'stripe-whatsapp', 'success', ?) ON DUPLICATE KEY UPDATE status=VALUES(status), processed_at=CURRENT_TIMESTAMP",
        "options": {
          "queryReplacement": "={{ $('Verify Stripe Signature').item.json.event_id }}, {{ $('Verify Stripe Signature').item.json.payload_hash }}"
        }
      },
      "id": "mysql-record-sms-success",
      "name": "MySQL: Record Success (SMS)",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [2240, 420],
      "credentials": {
        "mySql": {
          "id": "REPLACE_WITH_MYSQL_CRED_ID",
          "name": "MySQL (orders DB)"
        }
